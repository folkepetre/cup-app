# Molnläge (Supabase) styrs av om dessa nycklar finns.
#
# • npm run dev        → LOKALT läge (inget moln, data bara i din webbläsare)
# • npm run dev:cloud  → MOLNLÄGE  (läser .env.cloud, synkar mot Supabase)
#
# För att testa molnet lokalt: kopiera denna fil till .env.cloud och fyll i
# dina värden från Supabase (Settings → API). På Netlify sätts de istället
# som Environment variables.
VITE_SUPABASE_URL=https://DITT-PROJEKT.supabase.co
VITE_SUPABASE_ANON_KEY=din-anon-public-key
